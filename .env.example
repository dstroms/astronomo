# Copy to `.env` (cp .env.example .env). `.env` is git-ignored: put API keys there, never in code.
# A simulation needs nothing here. `python main.py --simulate --fast` runs as this file ships.
# Real environment variables override this file. Bare names (LLM_PROVIDER) and prefixed names
# (ASTRONOMO_LLM_PROVIDER) are equivalent; the prefixed one wins if both are set.
#
# Two groups live in this file: an optional language model, and the identity to set before a real
# upload. Plugin knobs, the telescope, archive replay, and an unattended night are in
# docs/configuration.md. The commands for a night are in docs/real-hardware.md.

# ---------------------------------------------------------------------------
# Language model (optional). Default `none` = no model, zero tokens, fully deterministic.
# Uncomment exactly ONE option below (if a key appears twice, the last line wins).
# ---------------------------------------------------------------------------
LLM_PROVIDER=none

# Option A - local and free (Ollama: https://ollama.com, then `ollama pull qwen2.5-coder:7b`)
# LLM_PROVIDER=ollama
# LLM_MODEL_NAME=qwen2.5-coder:7b
# LLM_BASE_URL=http://localhost:11434

# Option B - Anthropic. Use a model id from your Anthropic console; the key is read from here.
# LLM_PROVIDER=anthropic
# LLM_MODEL_NAME=<model-id>
# ANTHROPIC_API_KEY=<your-key>

# Option C - OpenAI. Use a model id from your OpenAI dashboard.
# LLM_PROVIDER=openai
# LLM_MODEL_NAME=<model-id>
# OPENAI_API_KEY=<your-key>

# Option D - any OpenAI-compatible server (vLLM, LM Studio, llama.cpp ...). Key often not needed.
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL_NAME=<served-model-name>

# Optional cost / safety limits (defaults shown). Details: docs/configuration.md
# LLM_MAX_CALLS_PER_MISSION=8
# LLM_MAX_TOKENS_PER_MISSION=20000
# LLM_MAX_OUTPUT_TOKENS=400
# LLM_STRICT=false        # true: an LLM failure fails the mission instead of falling back to plain text
# LLM_TIMEOUT_S=180       # raise for big local models on a slow machine
# LLM_NUM_CTX=4096        # Ollama context window

# ---------------------------------------------------------------------------
# Before a real upload. Leave these commented until you have them.
# A missing code still writes a DRAFT_ file. A code that is set and does not match the format
# stops startup. Nothing here is sent anywhere.
# ---------------------------------------------------------------------------
# ASTRONOMO_OBSERVER_NAME=              # submitter in the MPC ADES file (the AAVSO files do not use it)
# ASTRONOMO_AAVSO_OBS_CODE=             # 1-5 letters or digits. docs/runbooks/aavso-observer-code.md
# ASTRONOMO_MPC_STATION_CODE=           # three letters or digits, optional. docs/notes/mpc-observatory-code.md
# ASTRONOMO_SITE_LAT=39.7392            # or set the site in the dashboard: Opportunities, Observing site
# ASTRONOMO_SITE_LON=-104.9903          # east-positive
# ASTRONOMO_SITE_ELEV_M=1609
# ASTRONOMO_SITE_NAME=Home observatory

# An unattended night stays off. `python main.py --fetch-forecast` saves the forecast while this
# computer still has internet. Self-start (`ASTRONOMO_SELF_START`) is refused until you set
# `ASTRONOMO_UNATTENDED_CONFIRMED` yourself, after the interlocks and parking have been seen on
# this mount. Defaults and the other night settings: docs/configuration.md
